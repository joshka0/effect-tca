{
  "name": "effect-tca",
  "version": "0.0.1",
  "description": "Composable state, scoped effects, and feature testing for Effect.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshka0/effect-tca.git"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./FeatureEffect": { "types": "./dist/FeatureEffect.d.ts", "import": "./dist/FeatureEffect.js" },
    "./Feature": { "types": "./dist/Feature.d.ts", "import": "./dist/Feature.js" },
    "./Store": { "types": "./dist/Store.d.ts", "import": "./dist/Store.js" },
    "./TestStore": { "types": "./dist/TestStore.d.ts", "import": "./dist/TestStore.js" },
    "./StoreError": { "types": "./dist/StoreError.d.ts", "import": "./dist/StoreError.js" },
    "./atom": { "types": "./dist/atom.d.ts", "import": "./dist/atom.js" },
    "./atom/FeatureAtom": { "types": "./dist/atom/FeatureAtom.d.ts", "import": "./dist/atom/FeatureAtom.js" }
  },
  "dependencies": {
    "immer": "11.1.21"
  },
  "peerDependencies": {
    "effect": "^4.0.5"
  }
}
